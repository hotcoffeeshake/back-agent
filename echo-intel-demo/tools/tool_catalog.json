{
  "_note": "补齐闭环 2/3/4，工具名对齐 contracts/mcp-openapi.yaml。写类工具采用 operationId（如 hold_inventory）。L2/L3 写类工具需审批令牌与幂等键。",
  "transport": "http-mock-tool-gateway",
  "base_url": "http://<MOCK_TOOL_BASE_URL>",
